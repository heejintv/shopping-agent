# .env.example → .env로 복사한 뒤 값을 채우세요
# 새 검색(Claude 실행) 하루 최대 횟수. 캐시된 검색어는 제한 없음
DAILY_LIMIT=10

# 검색 엔진: claude (기본, claude -p 사용) 또는 gemini (Gemini API + Google 검색)
SEARCH_ENGINE=claude
# SEARCH_ENGINE=gemini 일 때 필요 (https://aistudio.google.com/apikey 에서 발급)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 상담 챗봇 엔진: gemini (기본) 또는 claude. gemini가 429·503이면 claude로 한 번 자동 재시도
CHAT_ENGINE=gemini
# 챗봇 대화 하루 최대 횟수 (외부 접속 기준, 내 PC는 무제한)
CHAT_DAILY_LIMIT=30
