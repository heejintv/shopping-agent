# .env.example → .env로 복사한 뒤 값을 채우세요
# 회원 한 명의 새 검색(Claude 실행) 하루 최대 횟수. 캐시된 검색어는 제한 없음. admin·내 PC는 무제한
DAILY_LIMIT=5

# 검색 엔진: claude (기본, claude -p 사용) 또는 gemini (Gemini API + Google 검색)
SEARCH_ENGINE=claude
# SEARCH_ENGINE=gemini 일 때 필요 (https://aistudio.google.com/apikey 에서 발급)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 상담 챗봇 엔진: gemini (기본) 또는 claude. gemini가 429·503·504이면 claude로 한 번 자동 재시도
CHAT_ENGINE=gemini
# 회원 한 명의 상담 하루 최대 횟수 (admin·내 PC는 무제한)
CHAT_DAILY_LIMIT=30

# ---- 로그인 (Supabase). 상담 챗봇은 로그인한 사람만 ----
# Supabase 대시보드 → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service_role 키: 서버 전용. 화면(config.js)·GitHub·로그에 절대 넣지 마세요
SUPABASE_SERVICE_KEY=

# ---- Render 배포용 (Render 대시보드의 Environment에 입력. 값은 여기 적지 마세요) ----
# claude -p 로그인 토큰. 내 PC에서 `claude setup-token`으로 발급
CLAUDE_CODE_OAUTH_TOKEN=
# 캐시·하루 횟수·모니터링 기록 폴더 (비우면 프로젝트 폴더)
DATA_DIR=
# 1이면 처음 켜질 때 demo/ 결과를 캐시로 불러옴 (Render에서는 자동)
SEED_DEMO=
